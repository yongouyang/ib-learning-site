{
  "id": "math-linear-myp",
  "subjectId": "math",
  "title": "Linear Graphs & Functions",
  "description": "Plotting coordinates, gradient, y-intercept, the equation y=mx+c, and parallel and perpendicular lines.",
  "ibLevel": "MYP",
  "notes": [
    {
      "id": "math-linear-myp-lin-n1",
      "heading": "Gradient and y-Intercept",
      "body": "Gradient m = (y₂−y₁)÷(x₂−x₁) measures steepness. Positive = upward, negative = downward, zero = horizontal. y-intercept c is where the line crosses the y-axis (x=0)."
    },
    {
      "id": "math-linear-myp-lin-n2",
      "heading": "y = mx + c",
      "body": "Every straight line can be written as y=mx+c. Given gradient and one point, use y−y₁=m(x−x₁). Given two points, find m first, then substitute to find c. Example: (1,3) and (3,7): m=2, c=1 → y=2x+1."
    },
    {
      "id": "math-linear-myp-lin-n3",
      "heading": "Parallel and Perpendicular",
      "body": "Parallel: same gradient (m₁=m₂). Perpendicular: m₁×m₂=−1 (negative reciprocals). Example: gradient 2 is perpendicular to −1/2."
    }
  ],
  "flashcards": [
    {
      "id": "math-linear-myp-lin-f1",
      "term": "Gradient",
      "definition": "Measure of steepness: (change in y)÷(change in x).",
      "example": "(2,1)→(6,9): m=8÷4=2."
    },
    {
      "id": "math-linear-myp-lin-f2",
      "term": "y-intercept",
      "definition": "Where line crosses y-axis (x=0), the c in y=mx+c.",
      "example": "y=3x−5 → y-intercept = −5."
    },
    {
      "id": "math-linear-myp-lin-f3",
      "term": "y=mx+c",
      "definition": "Standard straight line equation: m=gradient, c=y-intercept.",
      "example": "y=−2x+7: m=−2, c=7."
    },
    {
      "id": "math-linear-myp-lin-f4",
      "term": "Parallel lines",
      "definition": "Same gradient, never intersect.",
      "example": "y=4x+1 ∥ y=4x−3 (both m=4)."
    },
    {
      "id": "math-linear-myp-lin-f5",
      "term": "Perpendicular lines",
      "definition": "m₁×m₂=−1 (negative reciprocals).",
      "example": "m=3 ⊥ m=−1/3."
    }
  ],
  "questions": [
