    },
    {
      "id": "math-pythagoras-myp-pyt-f3",
      "term": "Pythagorean triple",
      "definition": "A set of three integers satisfying a² + b² = c².",
      "example": "3-4-5, 5-12-13, 8-15-17."
    },
    {
      "id": "math-pythagoras-myp-pyt-f4",
      "term": "Finding a shorter side",
      "definition": "a = √(c² − b²)",
      "example": "c=10, b=6 → a = √(100−36) = 8."
    },
    {
      "id": "math-pythagoras-myp-pyt-f5",
      "term": "Distance between two points",
      "definition": "d = √((x₂−x₁)² + (y₂−y₁)²)",
      "example": "(1,2) to (4,6) = √(9+16) = 5."
    },
    {
      "id": "math-pythagoras-myp-pyt-f6",
      "term": "Space diagonal",
      "definition": "d = √(l² + w² + h²) for a cuboid.",
