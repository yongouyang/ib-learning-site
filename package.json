{
  "name": "ib-learning-site",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:static": "npm run generate:sitemaps && bash scripts/build-static.sh && npm run verify:sitemaps",
    "build:lambda": "bash scripts/build-lambdas.sh",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:sweep": "npm run build && E2E_PROD=1 RUN_TOPIC_SWEEP=1 npm run test:e2e -- tests/e2e/topic-journeys.spec.ts --project='Desktop Chrome'",
    "test:e2e:static": "npm run build:static && E2E_STATIC=1 E2E_PROD=1 playwright test",
    "validate:content": "tsx scripts/validate-content.ts",
    "validate:illustrations": "tsx scripts/validate-illustrations.ts",
    "validate:illustration-layout": "node scripts/diagnose-illustrations.mjs",
    "render:illustrations": "node scripts/render-illustrations.mjs",
    "audit:content": "tsx scripts/audit-content.ts",
    "generate:registry": "tsx scripts/generate-registry.ts",
    "generate:sitemaps": "tsx scripts/generate-sitemaps.ts",
    "check:sitemaps": "tsx scripts/generate-sitemaps.ts --check",
    "verify:sitemaps": "tsx scripts/generate-sitemaps.ts --verify",
    "verify:seo:live": "tsx scripts/verify-seo-live.ts",
    "ping:indexnow": "node scripts/ping-indexnow.mjs",
    "test:coverage": "vitest run --coverage",
    "security:sast": "semgrep scan --config p/typescript --config p/react --config p/security-audit --config p/secrets --error",
    "security:sca": "osv-scanner scan -r .",
    "security": "npm run security:sast && npm run security:sca"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1111.0",
    "@aws-sdk/client-sesv2": "^3.1111.0",
    "@aws-sdk/lib-dynamodb": "^3.1111.0",
    "framer-motion": "^12.40.0",
    "katex": "^0.17.0",
    "lucide-react": "^1.18.0",
    "next": "^16.3.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/katex": "^0.16.8",
    "@types/node": "^24",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "jsdom": "^29.1.1",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "postcss-selector-parser": "^6.1.3"
  }
}
